# 복사해서 server/.env 로 쓰세요 (.env는 커밋하지 않습니다)

# writer 모델 (사용자에게 보이는 질문·공감·질문 이유, 블로그 글, 문체 프로필)
OPENAI_API_KEY=
# fast 모델 (쿼리·경험 판단, 측면 추출, 지표 문장 판정)
DEEPSEEK_API_KEY=

# 선택: 모델 이름 / 주소 바꾸기 (OpenAI 호환 API면 어디든 가능. 한 게이트웨이로 둘 다 쓸 때도 여기서 설정)
# WRITER_MODEL=gpt-5.6-luna
# WRITER_BASE_URL=
# WRITER_API_KEY=
# FAST_MODEL=deepseek-v4-flash
# FAST_BASE_URL=https://api.deepseek.com
# FAST_API_KEY=

# 선택: 형식 강제 방식 (1: json_schema strict, 0: JSON 모드 + 코드 검사)
# WRITER_STRICT_SCHEMA=1
# FAST_STRICT_SCHEMA=0

# 선택: 호출별 등급 바꾸기 (writer | fast)
# LLM_ROUTE_STEP5_FOLLOWUP=fast

# EMBED_MODEL=jhgan/ko-sroberta-multitask
