# 복사해서 server/.env 로 쓰세요 (.env는 커밋하지 않습니다)

# LLM: VibeHub LLM 게이트웨이 하나로 gpt-5.6-luna, deepseek-v4-flash를 모두 부릅니다.
# VibeHub에 배포한 앱에는 아래 두 값이 자동으로 들어갑니다. 로컬에서 돌릴 때만 직접 채우세요.
MINIAPP_LLM_BASE_URL=
MINIAPP_LLM_API_KEY=

# 선택: 모델 이름 바꾸기
# WRITER_MODEL=gpt-5.6-luna        # 사용자에게 보이는 질문·공감·질문 이유, 블로그 글, 문체 프로필
# FAST_MODEL=deepseek-v4-flash     # 쿼리·경험 판단, 측면 추출, 지표 문장 판정

# 선택: 게이트웨이 대신 각 회사 API를 직접 쓸 때
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# (또는 등급별로 WRITER_API_KEY / WRITER_BASE_URL, FAST_API_KEY / FAST_BASE_URL)

# 선택: 형식 강제 방식 (1: json_schema strict, 0: JSON 모드 + 코드 검사)
# WRITER_STRICT_SCHEMA=1
# FAST_STRICT_SCHEMA=0

# 선택: 호출별 등급 바꾸기 (writer | fast)
# LLM_ROUTE_STEP5_FOLLOWUP=fast

# EMBED_MODEL=jhgan/ko-sroberta-multitask
